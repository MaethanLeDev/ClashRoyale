{
  "name": "usmb-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "simtest": "tsx tools/simtest.ts",
    "train": "tsx training/train.ts",
    "train:night": "tsx training/train.ts --style night --hours 8",
    "train:report": "tsx training/report.ts",
    "train:inspect": "tsx training/inspect.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
